#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "windows.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE 9, 1

// Icon

IDI_BOOTSTRAPPER        ICON                    "res\\bootstrapper.ico"

// Version

#define VERSION         1,0,0,0
#define VERSION_STRING "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION
 PRODUCTVERSION VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AlexR32"
            VALUE "FileDescription", "Night-Runners Mod Menu Bootstrapper"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "bootstrapper.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 AlexR32. MIT License"
            VALUE "OriginalFilename", "bootstrapper.exe"
            VALUE "ProductName", "NRMM Bootstrapper"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// String Table

STRINGTABLE
BEGIN
    IDS_APP_TITLE       "NRMM Bootstrapper"
END

#endif    // English (United States) resources
